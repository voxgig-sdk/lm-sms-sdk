main: kit: target: py: publish: registry: package: 'voxgig-sdk-lm-sms-sdk'
main: kit: target: rb: publish: registry: package: 'voxgig-sdk-lm-sms-sdk'
main: kit: target: lua: publish: registry: package: 'voxgig-sdk-lm-sms-sdk'
main: kit: target: php: publish: registry: package: 'voxgig-sdk/lm-sms-sdk'

