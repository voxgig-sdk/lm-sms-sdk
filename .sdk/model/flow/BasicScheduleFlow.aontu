# BasicScheduleFlow

main: kit: flow: BasicScheduleFlow:
{
  entity: "schedule",
  kind: "basic",
  name: "BasicScheduleFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "schedule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "schedule_ref01",
        srcdatavar: "schedule_ref01_data",
        suffix: "_up0",
        textfield: "messageId"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-schedule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "schedule_ref01",
        srcdatavar: "schedule_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "schedule01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-schedule_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicScheduleFlow"
}