                        {
                          "required": [
                            "absolute"
                          ]
                        }
                      ],
                      "properties": {
                        "absolute": {
                          "description": "Absolute time specified of when this message should be sent. ISO8601 formatted string in UTC.",
                          "format": "date-time",
                          "type": "string"
                        },
                        "relative": {
                          "description": "Time specified in milliseconds of how much we will offset the message in the future. The maximum value is 3 months (7_889_232_000 milliseconds), which is also the default. The minimum value is 600000 ms (10 minutes)",
                          "format": "int64",
                          "maximum": 7889232000,
                          "minimum": 600000,
                          "type": "integer"
                        },
                        "tag": {
                          "description": "A tag for the message schedule. Can be used to group schedules by tag",
                          "maxLength": 100,
                          "minLength": 0,
                          "nullable": true,
                          "pattern": "[a-zA-Z0-9_-]+",
                          "type": "string"
                        }
                      },
                      "type": "object"
